{
  "schema": "yado.multi_resource_self_directed_data_task_loop.config.v1",
  "verified_experience_paths": [
    "experience/yado-endogenous-data-invariant-repair-v1.json",
    "experience/yado-cross-structure-invariant-repair-transfer-v1.json"
