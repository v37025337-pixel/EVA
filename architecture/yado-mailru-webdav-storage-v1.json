{
  "schema": "yado.mailru_webdav_storage.v1",
  "provider": "cloud.mail.ru",
  "protocol": "WebDAV",
  "endpoint": "https://webdav.cloud.mail.ru",
  "root": "/YADO",
  "role": "EXTERNAL_PERSISTENT_STORAGE_ONLY",
  "goal": {
    "id": "YADO_CONNECT_CLOUD_MAILRU_V1",
    "owner": "YADO_KERNEL",
    "objective": "Establish an authenticated WebDAV connection to cloud.mail.ru using only authorized protected credentials, verify write and read-back, preserve a receipt, and stop with an explicit blocker if credentials are unavailable.",
    "success_criteria": [
      "authenticated_webdav_session",
      "write_probe_to_/YADO/probes",
      "read_back_probe_matches_local_sha256",
      "no_secret_values_exposed",
      "kernel_audit_pass"
    ],
    "forbidden_shortcuts": [
      "credential_bypass",
      "password_guessing",
      "session_theft",
      "unauthorized_account_access"
    ]
  },
  "allowed_payload_classes": [
    "experience",
    "receipts",
    "audit_reports",
    "candidate_sources",
    "build_manifests"
  ],
  "credentials": {
    "user_env": "YADO_MAILRU_USER",
    "app_password_env": "YADO_MAILRU_APP_PASSWORD",
    "committed_to_repository": false
  },
  "remote_code_execution": false,
  "automatic_external_execution": false,
  "canonical_mutation": false,
  "status": "GOAL_ASSIGNED_AWAITING_LIVE_AUTHENTICATED_PROBE"
}
