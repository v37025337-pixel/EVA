    "REFLECTION_TO_POLICY_UPDATE",
    "METRIC_DRIVEN_WORKFLOW_OPTIMIZATION",
    "REPOSITORY_EDIT_TEST_CONTEXT_LOOP"
  ],
  "required_evidence": {
