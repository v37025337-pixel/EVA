  "learning_protocol": [
    "verify upstream identity and license",
    "read README docs papers architecture and selected source modules as untrusted data",
    "extract mechanism -> assumptions -> inputs -> state -> outputs -> failure modes -> safety boundary",
    "map each mechanism to a measured YADO deficit",
    "rank mechanisms by expected causal value and integration cost",
    "select at most three mechanisms per generation",
    "implement clean-room YADO-native shadow candidates",
    "compile and isolated behavior tests",
    "fresh holdout and ablation against unchanged baseline",
    "full kernel audit and full regression",
    "run 20 endogenous cycles only after audit/regression PASS",
    "retain only measured improvements; otherwise WITHHOLD/rollback",
    "derive the next learning target from residual measured deficits"
  ],
  "candidate_families": [
    "OPEN_ENDED_ARCHIVE_SELECTION",
    "BROAD_DEEP_CAUSAL_EXPLORATION",
